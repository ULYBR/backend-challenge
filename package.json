{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:e2e": "bun test test/e2e",
    "test:concurrency": "bun test test/concurrency",
    "test:all": "bun test test/unit && bun test test/integration && bun test test/e2e && bun test test/concurrency",
    "test:load": "bun src/interfaces/cli/load-test.ts",
    "db:migrate:up": "bun src/infrastructure/persistence/cli/migrate.ts up",
    "db:migrate:down": "bun src/infrastructure/persistence/cli/migrate.ts down",
    "db:migrate:status": "bun src/infrastructure/persistence/cli/migrate.ts status"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@mikro-orm/core": "^6.6.17",
    "@mikro-orm/migrations": "^6.6.17",
    "@mikro-orm/postgresql": "^6.6.17",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^12.0.3",
    "@nestjs/terminus": "^11.1.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@faker-js/faker": "^10.6.0",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
