NODE_ENV=development
PORT=3000
APP_ROLE=all
INSTANCE_ID=local-1
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering_processor
DB_HOST=localhost
DB_PORT=5433
DB_USER=wagering
DB_PASSWORD=wagering
DB_NAME=wagering_processor
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=5000

# AWS SQS (MiniStack / LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4567
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wallet-events.fifo
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SEC=30
SQS_WAIT_TIME_SEC=5

# Workers
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=15000
PENDING_REF_POLL_INTERVAL_MS=1000
PENDING_REF_MAX_ATTEMPTS=8
